{
  "name": "@let-aurn/swagger-client",
  "version": "0.8.0",
  "description": "Generate typed Angular and React clients from OpenAPI JSON files.",
  "type": "module",
  "bin": {
    "swagger-client": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "clean": "rm -rf dist test/tmp",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "openapi",
    "swagger",
    "typescript",
    "angular",
    "react",
    "client"
  ],
  "author": "let-aurn",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@angular/common": ">=16",
    "@angular/core": ">=16",
    "react": ">=18",
    "rxjs": ">=7"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "dependencies": {
    "tinyglobby": "^0.2.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/let-aurn/swagger-client.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
